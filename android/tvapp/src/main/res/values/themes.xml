<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the TV app — full-screen, no action bar, no title.
         Uses android:Theme.DeviceDefault.NoActionBar which is always present
         on Android TV (API 21+) without requiring AppCompat. -->
    <style name="Theme.MaxStream.NoActionBar" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
