rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own profile document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == userId;
    }

    // Per-user synced data (watch history + watchlist) used to sync activity
    // from the phone to the TV on sign-in. Only the owning user can access.
    match /users/{userId}/watch_history/{docId} {
      allow read, create, update, delete: if request.auth != null
                                        && request.auth.uid == userId;
    }

    match /users/{userId}/watchlist/{docId} {
      allow read, create, update, delete: if request.auth != null
                                        && request.auth.uid == userId;
    }

    // TV pairing codes: any signed-in user can create a code for themselves,
    // and any client (phone or TV, signed in or not) can look one up by exact
    // code to validate it. The code IS the credential, so only get-by-id is
    // allowed (no listing). A code can be marked used (burned) by whoever
    // holds it, but only once.
    match /device_codes/{code} {
      allow create: if request.auth != null
                   && request.resource.data.userId == request.auth.uid;
      allow get: if true;
      allow list: if false;
      allow update: if resource.data.isUsed == false
                   && request.resource.data.isUsed == true;
    }

    // Session/audit collections are written server-side or by the owning user.
    // The app writes these from the client, so allow authenticated writes.
    match /tv_authenticated_sessions/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    match /biometric_sessions/{docId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /login_audits/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
