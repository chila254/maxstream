<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch splash: black background with the MaxStream logo centered,
     shown while the process starts before Flutter renders its own splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item
        android:gravity="center"
        android:drawable="@drawable/maxstream_logo" />
</layer-list>
